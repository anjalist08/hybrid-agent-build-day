  {
    "name": "price_trip",
    "description": "Running total for the current choices. Re-runs automatically when its $binding args change.",
    "annotations": {
      "readOnlyHint": true
    },
    "inputSchema": {
      "type": "object",
      "properties": {
        "flight_id": {
          "type": "string"
        },
        "stay_id": {
          "type": "string"
        },
        "car_id": {
          "type": "string"
        },
        "seats": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": []
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "lines": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "left": {
                "type": "string"
              },
              "right": {
                "type": "string"
              }
            },
            "required": [
              "left",
              "right"
            ]
          }
        },
        "total": {
          "type": "number"
        },
        "currency": {
          "type": "string"
        },
        "ready": {
          "type": "boolean"
        },
        "label": {
          "type": "string"
        }
      }
    }
  },
  {
    "name": "book_trip",
    "description": "Pay and book everything chosen: the flight (with seats) as a Duffel order paid from the test balance, then the stay and the car. Write operation — use with Mutation().",
    "inputSchema": {
      "type": "object",
      "properties": {
        "flight_id": {
          "type": "string"
        },
        "travelers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "full names, lead traveler first"
        },
        "email": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        },
        "stay_id": {
          "type": "string"
        },
        "car_id": {
          "type": "string"
        },
        "seats": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "flight_id",
        "travelers",
        "email"
      ]
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "trip_id": {
          "type": "string"
        },
        "total": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "flight": {
          "type": "object",
          "properties": {
            "reference": {
              "type": "string"
            },
            "airline": {
              "type": "string"
            },
            "amount": {
              "type": "string"
            }
          }
        },
        "stay": {
          "type": "object",
          "properties": {
            "reference": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          }
        },
        "car": {
          "type": "object",
          "properties": {
            "reference": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  {
    "name": "notify_friends",
    "description": "Opens Messages on the phone with the itinerary pre-filled for the friends. Write operation — use with Mutation().",
    "inputSchema": {
      "type": "object",
      "properties": {
        "friends": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "friends",
        "message"
      ]
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    }
  }
]