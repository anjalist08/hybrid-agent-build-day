[
  {
    "name": "search_flights",
    "description": "Live flight offers from Duffel (round trip when return_date is given). Pass the whole result to OfferPicker. Use IATA airport or city codes.",
    "annotations": {
      "readOnlyHint": true
    },
    "inputSchema": {
      "type": "object",
      "properties": {
        "origin": {
          "type": "string"
        },
        "destination": {
          "type": "string"
        },
        "depart_date": {
          "type": "string",
          "description": "YYYY-MM-DD"
        },
        "return_date": {
          "type": "string",
          "description": "YYYY-MM-DD, optional"
        },
        "passengers": {
          "type": "number"
        },
        "cabin_class": {
          "type": "string",
          "enum": [
            "economy",
            "premium_economy",
            "business",
            "first"
          ]
        }
      },
      "required": [
        "origin",
        "destination",
        "depart_date",
        "passengers"
      ]
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "enum": [
            "duffel",
            "simulated"
          ]
        },
        "count": {
          "type": "number"
        },
        "summary": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "subtitle": {
                "type": "string"
              },
              "detail": {
                "type": "string"
              },
              "price": {
                "type": "number"
              },
              "currency": {
                "type": "string"
              },
              "badge": {
                "type": "string"
              },
              "image": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "kind",
              "title",
              "subtitle",
              "detail",
              "price",
              "currency",
              "badge",
              "image"
            ]
          }
        }
      }
    }
  },
  {
    "name": "get_seat_map",
    "description": "Seat map of the first outbound flight of an offer. Pass the whole result to CabinSeatMap. available=false when the airline has no seat selection.",
    "annotations": {
      "readOnlyHint": true
    },
    "inputSchema": {
      "type": "object",
      "properties": {
        "offer_id": {
          "type": "string"
        }
      },
      "required": [
        "offer_id"
      ]
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "offer_id": {
          "type": "string"
        },
        "available": {
          "type": "boolean"
        },
        "aisles": {
          "type": "number"
        },
        "columns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "currency": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    }
  },
