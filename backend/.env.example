# Cloud model for answering questions (and for extraction if LENS_EXTRACTOR=claude)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Screenshot extraction: "ollama" (local, private) or "claude" (cloud)
LENS_EXTRACTOR=ollama
OLLAMA_VISION_MODEL=qwen2.5vl:7b
# Retry in the cloud if the local model fails (off = screenshots never leave this machine)
LENS_CLOUD_FALLBACK=false

LENS_FRAME_INTERVAL=5
LENS_SAVE_FRAMES=false

# Answer routing: "auto" keeps simple lookups local and sends open-ended questions to Claude,
# "cloud" always tries Claude first, "local" never calls the cloud.
LENS_ROUTER=auto
# Start as if the network were unplugged (also switchable at runtime: POST /mode {"offline": true})
LENS_OFFLINE=false
# Local model for open-ended questions when the cloud is unavailable (defaults to the vision model)
# OLLAMA_TEXT_MODEL=qwen2.5vl:7b
LENS_CLOUD_TIMEOUT=25
