# Cloud model for answering questions (and for extraction if LENS_EXTRACTOR=claude)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Screenshot extraction: "ollama" (local, private) or "claude" (cloud)
LENS_EXTRACTOR=ollama
OLLAMA_VISION_MODEL=qwen2.5vl:7b
# Retry in the cloud if the local model fails (off = screenshots never leave this machine)
LENS_CLOUD_FALLBACK=false

# Cloud model used for screenshots when extraction runs in the cloud
CLAUDE_EXTRACT_MODEL=claude-haiku-5-5
# Hybrid burst: if the local model falls this many seconds behind, send frames to the cloud
# until it catches up. 0 = never (screenshots stay local).
LENS_CLOUD_BURST_LAG=0

LENS_FRAME_INTERVAL=5
# Per-frame debug dump (image + JSON + Markdown) under data/debug/. Turn off for real use.
LENS_DEBUG=true
LENS_IGNORE_APPS=lens,screen broadcast,control center
